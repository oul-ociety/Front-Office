<div class="content-columns">
    <% candidats.forEach(candidat => { %>
        <div class="col">
            <div class="item"><%= candidat.nom %> <%= candidat.prenom %></div>
            <% if (candidat.photo) { %>
                <div class="item"><img src="<%= candidat.photo %>" alt="<%= candidat.nom %>"></div>
            <% } %>
            <div class="item"><strong>Parti : </strong><%= candidat.nomPartie || 'Non spécifié' %></div>
            <div class="item"><strong>Slogan : </strong><%= candidat.slogan || 'Non spécifié' %></div>
            <div class="item"><strong>Programme : </strong><%= candidat.programme || 'Non spécifié' %></div>
            <div class="item"><strong>Vision : </strong><%= candidat.vision || 'Non spécifié' %></div>
        </div>
    <% }); %>
</div>