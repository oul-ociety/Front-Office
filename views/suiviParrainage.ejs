<link rel="stylesheet" href="/css/suivi.css">
<div class="table-wrapper">
    <table class="fl-table">
        <thead>
            <tr>
                <th>N° d'ordre</th>
                <th>Date de parrainage</th>
                <th>Statut</th>
                <th>Nom du candidat</th>
                <th>Nom de l'électeur</th>
                <th>Email de l'électeur</th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach((parrainage, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= parrainage.date_parrainage.toLocaleString() %></td>
                    <td><%= parrainage.statut_parrainage %></td>
                    <td><%= parrainage.candidat.nom %> <%= parrainage.candidat.prenom %></td>
                    <td><%= parrainage.electeur.nom %> <%= parrainage.electeur.prenom %></td>
                    <td><%= parrainage.electeur.email %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>