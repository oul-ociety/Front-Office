<div class="content-columns">
    <% candidats.forEach(candidat => { %>
      <div class="col">
        <div class="item"><%= candidat.prenom %> <%= candidat.nom %></div>
        <div class="item">
          <img style="width: 100%" src="<%= candidat.photo %>" alt="<%= candidat.prenom %> <%= candidat.nom %>">
        </div>
        <div class="item"><strong>Parti : </strong><%= candidat.nomPartie %></div>
        <div class="item"><strong>Slogan : </strong><%= candidat.slogan %></div>
        <div class="item"><strong>Programme : </strong>Progresser ensemble, lutter contre les inégalités.</div>
        <div class="item"><strong>Vision : </strong>Un Sénégal uni et solidaire, dans un environnement de paix et de prospérité.</div>
        <button onclick="startParrainageProcess(<%= candidat.id_candidat %>, '<%= candidat.prenom %> <%= candidat.nom %>')">Parrainer</button>
      </div>
    <% }) %>
  </div>
  
  <!-- Inclure SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    function startParrainageProcess(candidatId, candidatName) {
      Swal.fire({
        title: `Parrainer ${candidatName}`,
        input: 'email',
        inputPlaceholder: 'Entrez votre e-mail',
        showCancelButton: true,
        confirmButtonText: 'Suivant',
        cancelButtonText: 'Annuler',
        preConfirm: (email) => {
          if (!email) {
            Swal.showValidationMessage('Veuillez entrer une adresse e-mail valide');
            return false;
          }
          return email;
        }
      }).then((emailResult) => {
        if (emailResult.isConfirmed) {
          const email = emailResult.value;
  
          // Envoyer le code à l'e-mail de l'utilisateur
          fetch('/dashboard/electeur/send-code', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email }),
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              // Demander le code de parrainage
              Swal.fire({
                title: `Parrainer ${candidatName}`,
                input: 'text',
                inputPlaceholder: 'Entrez le code de parrainage',
                showCancelButton: true,
                confirmButtonText: 'Valider',
                cancelButtonText: 'Annuler',
                preConfirm: (code) => {
                  if (!code) {
                    Swal.showValidationMessage('Veuillez entrer un code de parrainage');
                    return false;
                  }
                  return code;
                }
              }).then((codeResult) => {
                if (codeResult.isConfirmed) {
                  const code = codeResult.value;
  
                  // Vérifier le code saisi
                  fetch('/dashboard/electeur/verify-code', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email, code }),
                  })
                  .then(response => response.json())
                  .then(data => {
                    if (data.success) {
                      Swal.fire({
                        icon: 'success',
                        title: 'Parrainage validé !',
                        text: `Vous avez parrainé ${candidatName} avec l'e-mail ${email}`,
                      });
                    } else {
                      Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: data.message || 'Code de parrainage incorrect. Veuillez réessayer.',
                      });
                    }
                  })
                  .catch(error => {
                    Swal.fire({
                      icon: 'error',
                      title: 'Erreur',
                      text: 'Une erreur s\'est produite. Veuillez réessayer.',
                    });
                  });
                }
              });
            } else {
              Swal.fire({
                icon: 'error',
                title: 'Erreur',
                text: "Échec de l'envoi du code. Veuillez réessayer.",
              });
            }
          })
          .catch(error => {
            Swal.fire({
              icon: 'error',
              title: 'Erreur',
              text: 'Une erreur s\'est produite. Veuillez réessayer.',
            });
          });
        }
      });
    }
  </script>